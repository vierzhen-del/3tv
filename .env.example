# 로컬 실행용 환경변수 — 이 파일을 .env로 복사해 값 채우기 (.env는 커밋 금지)
# GitHub Actions에서는 동일 키를 repo Secrets로 등록
#
# ★ 기존 v28의 C:\3protv\.env 를 그대로 사용해도 됩니다.
#   동일 키(TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID/TELEGRAM_NOTIFY_CHANNEL,
#   GEMINI_API_KEY, NOTION_API_KEY, NOTION_PARENT_ID)를 자동 인식하며,
#   사용하지 않는 키(YOUTUBE_API_KEY 등)가 남아 있어도 무해합니다.

# 필수: AI 분석
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 필수: 텔레그램 (기존 3protv 알림봇 재사용 가능)
# 여러 방에 동시 발송하려면 chat id를 콤마로 나열 (예: 12345,-1009876543210)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 선택: 카카오 나에게 보내기 (scripts/kakao_get_token.py로 발급)
KAKAO_REST_API_KEY=
KAKAO_REFRESH_TOKEN=

# 선택: 옵시디안 볼트 push + 카카오 토큰 자동갱신용 GitHub PAT
#  - repo 권한 (볼트 repo 접근 + Actions secrets 쓰기)
GH_PAT=

# 선택: 유튜브 봇차단 대응 쿠키 (cookies.txt 파일 내용 전체를 붙여넣기)
YOUTUBE_COOKIES=

# 선택: KRX 회원 로그인 (data.krx.co.kr 계정) — pykrx가 인증 요청을 보내
#  국내 종목 시세 조회 신뢰도가 올라간다. 미설정 시 익명 요청으로 폴백.
KRX_ID=
KRX_PW=

# 권장: 네이버 검색 API (무료 하루 25,000건) — 종목별 관련 기사 + 뉴스 브리핑
#  API HUB(신규) 키와 개발자센터(기존) 키 모두 이 두 변수에 넣으면 자동 판별된다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 선택: 노션 아카이브 (settings.yaml에서 notion.enabled: true 필요)
NOTION_API_KEY=
NOTION_PARENT_ID=
