{
  "name": "3tv 리포트 → RaeVault 동기화",
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Seoul"
  },
  "nodes": [
    {
      "id": "schedule",
      "name": "평일 07:10 / 08:50 / 13:00 / 17:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "10 7 * * 1-5"
            },
            {
              "field": "cronExpression",
              "expression": "50 8 * * 1-5"
            },
            {
              "field": "cronExpression",
              "expression": "0 13 * * 1-5"
            },
            {
              "field": "cronExpression",
              "expression": "30 17 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "calcpath",
      "name": "오늘 경로 계산",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "jsCode": "// OWNER를 본인 GitHub 계정으로 수정하세요\nconst OWNER = \"vierzhen-del\";\nconst REPO = \"3tv-reports\";\nconst now = new Date(new Date().toLocaleString(\"en-US\", {timeZone: \"Asia/Seoul\"}));\nconst yyyy = String(now.getFullYear());\nconst mm = String(now.getMonth() + 1).padStart(2, \"0\");\nconst ymd = yyyy + mm + String(now.getDate()).padStart(2, \"0\");\n// hour: 마지막 슬롯(09:40)에서만 누락 경고를 보내기 위한 판단 근거.\n// 07:10 슬롯엔 kr 병합본이 아직 없는 게 정상이라 그때 경고하면 매일 오탐이 난다.\nconst hour = now.getHours();\nconst apiUrl = `https://api.github.com/repos/${OWNER}/${REPO}/contents/3protv/${yyyy}/${mm}?ref=main`;\nreturn [{ json: { yyyy, mm, ymd, hour, apiUrl } }];"
      }
    },
    {
      "id": "listfiles",
      "name": "파일 목록 조회",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        0
      ],
      "alwaysOutputData": true,
      "parameters": {
        "url": "={{ $json.apiUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer <REDACTED>"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-3tv-sync"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "filtertoday",
      "name": "오늘 파일 필터",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "jsCode": "let __backfill = false;\ntry { $('백필 대상 월').first(); __backfill = true; } catch (e) {}\nif (__backfill) {\n  const files = $input.all().map(i => i.json);\n  const mdFiles = files.filter(f => f.name && f.name.endsWith('.md'));\n  return mdFiles.map(f => ({ json: {\n    missing: false,\n    name: f.name,\n    download_url: f.download_url,\n    target: `/root/obsidian/${f.path}`\n  }}));\n}\n\nconst { yyyy, mm, ymd, hour } = $('오늘 경로 계산').first().json;\nconst files = $input.all().map(i => i.json);\n// 404(폴더 없음)면 {message:\"Not Found\"} 한 건이 온다 — name이 없어 아래 필터에서 걸러진다\nconst today = files.filter(f => f.name && f.name.includes(ymd) && f.name.endsWith('.md'));\n\nif (today.length === 0) {\n  // 07:10 슬롯은 kr 병합본이 없는 게 정상 → 마지막 슬롯(17:30)에서만 경고\n  if (hour < 9) return [];\n  return [{ json: {\n    missing: true,\n    text: `⚠️ 3tv 리포트 동기화 누락 (${ymd})\\n\\n`\n        + `3tv-reports의 3protv/${yyyy}/${mm}/ 에 오늘 날짜 md가 없습니다.\\n`\n        + `옵시디안(탭S9·S26)에 오늘 리포트가 안 올라갑니다.\\n\\n`\n        + `확인: GitHub Actions의 us/kr-session 실행 결과 → vault-check 워크플로`\n  }}];\n}\nconst results = today.map(f => ({ json: {\n  missing: false,\n  name: f.name,\n  download_url: f.download_url,\n  target: `/root/obsidian/3protv/${yyyy}/${mm}/${f.name}`\n}}));\n\n// _index.md는 파일명에 날짜가 없어 위 today 필터에 절대 안 걸린다 — 그래서\n// 정기 동기화로는 한 번도 갱신된 적이 없었다(2026-08-14 발견, 사용자가 볼트\n// 인덱스 파일이 8/11에서 멈춰있는 걸 보고 잡아냈다). missing 판정과는 분리해\n// 매 실행마다 항상 최신본으로 덮어써서 실제 리포트와 어긋나지 않게 한다.\n// (백필 경로는 위 __backfill 분기에서 이미 모든 .md를 가져오므로 _index.md도\n// 자동 포함된다 — 아래 추가 로직은 정기 스케줄 경로 전용.)\nconst indexFile = files.find(f => f.name === '_index.md');\nif (indexFile) {\n  results.push({ json: {\n    missing: false,\n    name: indexFile.name,\n    download_url: indexFile.download_url,\n    target: `/root/obsidian/3protv/${yyyy}/${mm}/${indexFile.name}`\n  }});\n}\nreturn results;"
      }
    },
    {
      "id": "download",
      "name": "md 다운로드",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        100
      ],
      "parameters": {
        "url": "={{ $('오늘 파일 필터').item.json.download_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer <REDACTED>"
            },
            {
              "name": "User-Agent",
              "value": "n8n-3tv-sync"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      }
    },
    {
      "id": "writefile",
      "name": "RaeVault에 저장",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1180,
        100
      ],
      "parameters": {
        "operation": "write",
        "fileName": "={{ $('오늘 파일 필터').item.json.target }}",
        "options": {}
      }
    },
    {
      "id": "if-missing",
      "name": "누락?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "missing-flag",
              "leftValue": "={{ $json.missing }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "tg-alert",
      "name": "텔레그램 경고",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        -160
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot<REDACTED>/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: \"5607052382\", text: $json.text }) }}",
        "options": {}
      }
    },
    {
      "id": "mkdirfix2",
      "name": "저장 전 폴더 생성",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1080,
        100
      ],
      "executeOnce": true,
      "parameters": {
        "command": "=mkdir -p \"$(dirname \"{{ $json.target }}\")\"; if [ \"$(basename \"{{ $json.target }}\")\" = \"_index.md\" ]; then echo MISSING; elif [ -f \"{{ $json.target }}\" ]; then echo EXISTS; else echo MISSING; fi"
      }
    },
    {
      "id": "backfilltrigger",
      "name": "백필 수동 실행",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        200,
        300
      ],
      "disabled": true,
      "parameters": {}
    },
    {
      "id": "backfillmonths",
      "name": "백필 대상 월",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ],
      "parameters": {
        "jsCode": "const OWNER = \"vierzhen-del\";\nconst REPO = \"3tv-reports\";\nconst months = [\"07\", \"08\"];\nreturn months.map(mm => ({ json: {\n  yyyy: \"2026\",\n  mm,\n  apiUrl: `https://api.github.com/repos/${OWNER}/${REPO}/contents/3protv/2026/${mm}?ref=main`\n}}));"
      }
    },
    {
      "id": "batchloop",
      "name": "배치 반복",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        850,
        300
      ],
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "skipcheck2",
      "name": "이미 저장됨?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1080,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "exists-flag",
              "leftValue": "={{ $json.stdout.trim() }}",
              "rightValue": "MISSING",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    }
  ],
