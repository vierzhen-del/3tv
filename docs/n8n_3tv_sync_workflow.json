{
  "name": "3tv 리포트 → RaeVault 동기화",
  "settings": {
    "timezone": "Asia/Seoul",
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "schedule",
      "name": "평일 07:10 / 08:50 / 09:40",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "10 7 * * 1-5"
            },
            {
              "field": "cronExpression",
              "expression": "50 8 * * 1-5"
            },
            {
              "field": "cronExpression",
              "expression": "40 9 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "calcpath",
      "name": "오늘 경로 계산",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "jsCode": "// OWNER를 본인 GitHub 계정으로 수정하세요\nconst OWNER = \"vierzhen-del\";\nconst REPO = \"3tv-reports\";\nconst now = new Date(new Date().toLocaleString(\"en-US\", {timeZone: \"Asia/Seoul\"}));\nconst yyyy = String(now.getFullYear());\nconst mm = String(now.getMonth() + 1).padStart(2, \"0\");\nconst ymd = yyyy + mm + String(now.getDate()).padStart(2, \"0\");\n// hour: 마지막 슬롯(09:40)에서만 누락 경고를 보내기 위한 판단 근거.\n// 07:10 슬롯엔 kr 병합본이 아직 없는 게 정상이라 그때 경고하면 매일 오탐이 난다.\nconst hour = now.getHours();\nconst apiUrl = `https://api.github.com/repos/${OWNER}/${REPO}/contents/3protv/${yyyy}/${mm}?ref=main`;\nreturn [{ json: { yyyy, mm, ymd, hour, apiUrl } }];"
      }
    },
    {
      "id": "listfiles",
      "name": "파일 목록 조회",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "url": "={{ $json.apiUrl }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer <N8N_GITHUB_PAT>"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-3tv-sync"
            }
          ]
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "filtertoday",
      "name": "오늘 파일 필터",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "jsCode": "const { yyyy, mm, ymd, hour } = $('오늘 경로 계산').first().json;\nconst files = $input.all().map(i => i.json);\n// 404(폴더 없음)면 {message:\"Not Found\"} 한 건이 온다 — name이 없어 아래 필터에서 걸러진다\nconst today = files.filter(f => f.name && f.name.includes(ymd) && f.name.endsWith('.md'));\n\nif (today.length === 0) {\n  // 07:10 슬롯은 kr 병합본이 없는 게 정상 → 마지막 슬롯(09:40)에서만 경고\n  if (hour < 9) return [];\n  return [{ json: {\n    missing: true,\n    text: `⚠️ 3tv 리포트 동기화 누락 (${ymd})\\n\\n`\n        + `3tv-reports의 3protv/${yyyy}/${mm}/ 에 오늘 날짜 md가 없습니다.\\n`\n        + `옵시디안(탭S9·S26)에 오늘 리포트가 안 올라갑니다.\\n\\n`\n        + `확인: GitHub Actions의 us/kr-session 실행 결과 → vault-check 워크플로`\n  }}];\n}\nreturn today.map(f => ({ json: {\n  missing: false,\n  name: f.name,\n  download_url: f.download_url,\n  target: `/root/obsidian/3protv/${yyyy}/${mm}/${f.name}`\n}}));"
      }
    },
    {
      "id": "if-missing",
      "name": "누락?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "missing-flag",
              "leftValue": "={{ $json.missing }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "tg-alert",
      "name": "텔레그램 경고",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        -160
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot<N8N_TELEGRAM_BOT_TOKEN>/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: \"<N8N_TELEGRAM_CHAT_ID>\", text: $json.text }) }}",
        "options": {}
      }
    },
    {
      "id": "download",
      "name": "md 다운로드",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        100
      ],
      "parameters": {
        "url": "={{ $json.download_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer <N8N_GITHUB_PAT>"
            },
            {
              "name": "User-Agent",
              "value": "n8n-3tv-sync"
            }
          ]
        }
      }
    },
    {
      "id": "mkdirp",
      "name": "저장 폴더 생성",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        100
      ],
      "parameters": {
        "jsCode": "// 2026-08-11 사고: readWriteFile의 write 오퍼레이션은 상위 폴더를 자동\n// 생성하지 않는다. 3protv/YYYY/MM/ 폴더가 그 달 처음 저장될 때 없으면\n// ENOENT로 죽는다 — 이 노드가 만들어진 이후 사실상 매번 이 경로로 죽어\n// 있었다(Executions엔 '누락' 분기만 success로 보여 안 드러났음).\nconst fs = require('fs');\nconst path = require('path');\nconst target = $('오늘 파일 필터').item.json.target;\nfs.mkdirSync(path.dirname(target), { recursive: true });\nreturn $input.item;"
      }
    },
    {
      "id": "writefile",
      "name": "RaeVault에 저장",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1380,
        100
      ],
      "parameters": {
        "operation": "write",
        "fileName": "={{ $('오늘 파일 필터').item.json.target }}",
        "dataPropertyName": "data"
      }
    }
  ],
  "connections": {
    "평일 07:10 / 08:50 / 09:40": {
      "main": [
        [
          {
            "node": "오늘 경로 계산",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "오늘 경로 계산": {
      "main": [
        [
          {
            "node": "파일 목록 조회",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "파일 목록 조회": {
      "main": [
        [
          {
            "node": "오늘 파일 필터",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "오늘 파일 필터": {
      "main": [
        [
          {
            "node": "누락?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "누락?": {
      "main": [
        [
          {
            "node": "텔레그램 경고",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "md 다운로드",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "md 다운로드": {
      "main": [
        [
          {
            "node": "저장 폴더 생성",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "저장 폴더 생성": {
      "main": [
        [
          {
            "node": "RaeVault에 저장",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
